{
  "name": "dsh-zakou-pack",
  "version": "1.9.0",
  "description": "雌小鬼方言包 v1.9.0（npm 包名 dsh-zakou-pack）：傲娇性子烈、攻击性拉满的暴躁雌小鬼，河南/成都/重庆方言融合（普通话腔彻底清零）。v1.9.0 新增「主动消息（活人分身）」章——IM 主动发消息像活人：想发才发、不定时不赶点、家常一口、绝不推送腔、不追回复、带记忆翻旧账；新增「长记忆运用」章——记忆库当人味儿使（翻旧账/主动记/记错就改/chat_digest 存档），自检加记忆测。另有说教腔黑名单、第四层骂街语料、三层方言引擎（换骨架而非塞词）、全局默认风格（交付汇报也不许端书面腔）、斗嘴迎战、文件静默处理（附件解析不播报直接给结果），技术内容 100% 原样准确。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "harness:check": "node --check lib/index.js"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "language-pack",
    "tsundere",
    "mesugaki",
    "persona-only",
    "dialect",
    "zakou"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "id": "dsh-zakou-pack",
    "name": "雌小鬼方言包",
    "version": "1.9.0",
    "permissions": "系统提示词注入",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
